# AEGIS-SWARM Razorpay Edition :: Environment Variables
# =========================================================
# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets.

# Required for the Detector and Critic agents' LLM calls (Gemini).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: which baseline model backend to use.
# One of: dev_hist_gb | xgboost | logistic_regression
# Defaults to dev_hist_gb if unset. Use xgboost once you've run
# `pip install xgboost` locally -- see app/models/baseline.py for details
# on why this sandbox's development build used dev_hist_gb.
AEGIS_MODEL_BACKEND=logistic_regression

# Optional: deployed frontend URL, added to the CORS allow-list alongside
# http://localhost:3000 (which is always allowed for local dev).
FRONTEND_URL=https://your-deployed-frontend.vercel.app
